<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only. Runs on the Windows CI job; does not build on Linux. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Ghostty.Tests.Windows</RootNamespace>
    <AssemblyName>Ghostty.Tests.Windows</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == ''">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The animation-activity registry's lifecycle tests run real XAML
         objects (Storyboard Completed, FrameworkElement unload) under the
         same runtime the app ships with, self-contained so the verdict
         does not depend on what a host has installed system-wide. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Unpackaged, like the app: no MSIX identity is needed to create XAML
         objects and start animations on them. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ghostty.Core\Ghostty.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared file, linked: the four test hosts cannot drift. -->
    <Compile Include="..\build\TestHostArming.cs" Link="TestHostArming.cs" />
    <!-- The registry under test, compiled from the same source the app
         builds: the lifecycle tests exercise the exact file the shell
         routes through, not a copy that can drift. -->
    <Compile Include="..\Ghostty\Services\AnimationActivityRegistry.cs" Link="Motion\AnimationActivityRegistry.cs" />
    <!--
      The support dump's state read and its compose, for
      Motion.AnimationsStateTests: AnimationsState is plain C# over
      MotionGating and the OS animations read (which this TFM can compile,
      unlike the plain Ghostty.Tests host), and the copy-time freshness its
      payload depends on is behavioural. MotionGating links as it does into
      Ghostty.Tests; the two Motion files are the seam it routes through,
      named rather than globbed because the folder also carries
      PaneFadeTracker, whose CS0649 noise this project never carried and
      whose tracker the dump never reads.
    -->
    <Compile Include="..\Ghostty\Motion\IPaneMotionCoordinator.cs" Link="Motion\IPaneMotionCoordinator.cs" />
    <Compile Include="..\Ghostty\Motion\MotionRegistration.cs" Link="Motion\MotionRegistration.cs" />
    <Compile Include="..\Ghostty\Services\MotionGating.cs" Link="Motion\MotionGating.cs" />
    <Compile Include="..\Ghostty\Services\SystemAnimations.cs" Link="Motion\SystemAnimations.cs" />
    <Compile Include="..\Ghostty\Services\AnimationsState.cs" Link="Motion\AnimationsState.cs" />
  </ItemGroup>
</Project>
