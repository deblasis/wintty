<Page
    x:Class="Ghostty.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Ghostty.Controls.Settings">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800">
            <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <ctrl:SettingsGroup Header="App Behavior">
                <ctrl:SettingsCard
                    Header="Auto-reload config"
                    Description="Watch the config file for changes and reload automatically."
                    ctrl:SettingsCard.ConfigKey="auto-reload-config">
                    <ToggleSwitch
                        x:Name="AutoReloadToggle"
                        OffContent="Manual reload only"
                        OnContent="Watch file for changes"
                        Toggled="AutoReloadToggle_Toggled" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Vertical tabs"
                    Description="Arrange tabs in a sidebar instead of a horizontal bar."
                    ctrl:SettingsCard.ConfigKey="vertical-tabs">
                    <ToggleSwitch
                        x:Name="VerticalTabsToggle"
                        OffContent="Horizontal tab bar"
                        OnContent="Vertical tab sidebar"
                        Toggled="VerticalTabsToggle_Toggled" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Vertical tab width"
                    Description="Expanded sidebar width in pixels when vertical tabs are pinned. 80–600, default 220."
                    ctrl:SettingsCard.ConfigKey="vertical-tabs-width">
                    <NumberBox
                        x:Name="VerticalTabsWidthBox"
                        Value="220"
                        Minimum="80"
                        Maximum="600"
                        SmallChange="10"
                        LargeChange="40"
                        SpinButtonPlacementMode="Compact"
                        MinWidth="160"
                        ValueChanged="VerticalTabsWidth_ValueChanged" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Pin vertical tabs expanded"
                    Description="Start the vertical sidebar expanded. The chevron still toggles at runtime."
                    ctrl:SettingsCard.ConfigKey="vertical-tabs-pinned">
                    <ToggleSwitch
                        x:Name="VerticalTabsPinnedToggle"
                        OffContent="Icon rail"
                        OnContent="Pinned expanded"
                        Toggled="VerticalTabsPinnedToggle_Toggled" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Expand vertical tabs on hover"
                    Description="Hovering the collapsed rail expands the sidebar. Leave it to collapse again unless pinned."
                    ctrl:SettingsCard.ConfigKey="vertical-tabs-hover-expand">
                    <ToggleSwitch
                        x:Name="VerticalTabsHoverToggle"
                        OffContent="Click chevron to expand"
                        OnContent="Expand on hover"
                        Toggled="VerticalTabsHoverToggle_Toggled" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Undo timeout (ms)"
                    Description="How long a pane split, close, resize, or zoom can be undone (Ctrl+Shift+Z), in milliseconds. Set to 0 to disable undo. Ghostty default is 5000 (5 seconds)."
                    ctrl:SettingsCard.ConfigKey="undo-timeout">
                    <!-- Milliseconds (the config's native Duration granularity)
                         so no value is lost in a seconds round-trip. Maximum
                         mirrors ConfigService's int clamp (~24.8 days), so the
                         box never clamps a value the config can represent.
                         Value here is a placeholder; LoadValues sets the real one. -->
                    <NumberBox
                        x:Name="UndoTimeoutBox"
                        Value="5000"
                        Minimum="0"
                        Maximum="2147483647"
                        SmallChange="100"
                        LargeChange="1000"
                        SpinButtonPlacementMode="Compact"
                        MinWidth="160"
                        ValueChanged="UndoTimeout_ValueChanged" />
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Confirm close"
                    Description="When to confirm closing a tab: never, when the tab has multiple panes, or always."
                    ctrl:SettingsCard.ConfigKey="confirm-close-surface">
                    <ComboBox x:Name="ConfirmCloseCombo" MinWidth="180"
                              SelectionChanged="ConfirmClose_SelectionChanged">
                        <ComboBoxItem Tag="false" Content="Never" />
                        <ComboBoxItem Tag="true" Content="Multiple panes" />
                        <ComboBoxItem Tag="always" Content="Always" />
                    </ComboBox>
                </ctrl:SettingsCard>

                <ctrl:SettingsCard Header="Configuration"
                                   Description="Reload from disk or open the config file in your default editor.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reload" Click="ReloadButton_Click" />
                        <Button Content="Open File" Click="OpenFileButton_Click" />
                    </StackPanel>
                </ctrl:SettingsCard>
            </ctrl:SettingsGroup>

            <ctrl:SettingsGroup Header="Command Palette"
                                Description="Look and grouping of the command palette overlay.">
                <ctrl:SettingsCard
                    Header="Command palette backdrop"
                    Description="Backdrop material for the command palette overlay (acrylic, mica, or opaque)."
                    ctrl:SettingsCard.ConfigKey="command-palette-background">
                    <ComboBox x:Name="PaletteBackgroundCombo" MinWidth="180"
                              SelectionChanged="PaletteBackground_SelectionChanged">
                        <ComboBoxItem Tag="acrylic" Content="Acrylic" />
                        <ComboBoxItem Tag="mica" Content="Mica" />
                        <ComboBoxItem Tag="opaque" Content="Opaque" />
                    </ComboBox>
                </ctrl:SettingsCard>

                <ctrl:SettingsCard
                    Header="Group palette commands by category"
                    Description="Group entries in the command palette by category instead of listing them flat."
                    ctrl:SettingsCard.ConfigKey="command-palette-group-commands">
                    <ToggleSwitch
                        x:Name="PaletteGroupToggle"
                        OffContent="Flat list"
                        OnContent="Grouped by category"
                        Toggled="PaletteGroupToggle_Toggled" />
                </ctrl:SettingsCard>
            </ctrl:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</Page>
