<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ghostty.Tabs.VerticalTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:branding="using:Ghostty.Branding"
    xmlns:tabs="using:Ghostty.Tabs"
    Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="StripAccentBrush" Color="{ThemeResource SystemAccentColor}" />
    </UserControl.Resources>

    <!-- NavView is pane-only: terminal lives in MainWindow.PaneHostContainer.
         LeftCompact+IsPaneOpen in a fixed-width column allocates pane AND
         content side-by-side and draws over the terminal. -->
    <Grid>
        <!-- Behind NavView so row fill does not paint over icons/text. -->
        <Canvas x:Name="SelectionRowHost" IsHitTestVisible="False">
            <Border x:Name="SelectionRow"
                    Visibility="Collapsed"
                    CornerRadius="0"/>
        </Canvas>

        <controls:NavigationView x:Name="NavView"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="False"
                                 IsPaneToggleButtonVisible="False"
                                 PaneDisplayMode="LeftCompact"
                                 OpenPaneLength="220"
                                 CompactPaneLength="48"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 SelectionChanged="OnNavSelectionChanged"/>
    </Grid>
</UserControl>
