<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ghostty.Tabs.VerticalTabHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:branding="using:Ghostty.Branding"
    xmlns:tabs="using:Ghostty.Tabs"
    RequestedTheme="Dark"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <!-- App icon + new-tab live outside NavigationView; custom pane header/
         footer controls crash MUXC measure when NavView is strip-sized. -->
    <Grid x:Name="StripRoot" Background="Transparent" ContextRequested="OnStripContextRequested">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StripColumn" Width="48"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="0">
            <!-- Quake/borderless only: title bar hidden, icon lives here. -->
            <branding:AppIconBadge x:Name="IconBadgeHost"
                                   Visibility="Collapsed"/>

            <!-- Custom pane toggle below the shared title-row icon lane.
                 NavView's built-in hamburger is hidden; MUXC auto-close
                 on its pane events fought the outer column width. -->
            <Button x:Name="PaneToggleButton"
                    Width="40"
                    Height="32"
                    Margin="4,0,4,4"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaneToggleClick"
                    AutomationProperties.AutomationId="PaneToggleButton"
                    AutomationProperties.Name="Toggle sidebar"
                    ToolTipService.ToolTip="Expand sidebar">
                <FontIcon x:Name="PaneToggleIcon"
                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE700;"
                          FontSize="14"/>
            </Button>
        </StackPanel>

        <ContentPresenter x:Name="StripHost"
                          Grid.Row="1"
                          Grid.Column="0"/>

        <tabs:NewTabSplitButton x:Name="NewTabButton"
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="4"
                                Orientation="Vertical"
                                FlyoutPlacement="Right"/>

        <Grid x:Name="HandleHost"
              Grid.Row="1"
              Grid.Column="0"
              HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
