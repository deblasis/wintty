{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/scripts/pr_gate.py", "--hook"],
            "timeout": 90,
            "statusMessage": "pr-gate: validating merge"
          },
          {
            "type": "command",
            "command": "python",
            "args": [".claude/scripts/workspace_guard.py", "--check"],
            "timeout": 30,
            "statusMessage": "workspace-guard: checking for foreign changes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [".claude/scripts/workspace_guard.py", "--track"],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
