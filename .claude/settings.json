{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/pr_gate.py", "--hook"],
            "timeout": 90,
            "statusMessage": "quality gates"
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/workspace_guard.py", "--check"],
            "timeout": 30,
            "statusMessage": "quality gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/workspace_guard.py", "--track"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
